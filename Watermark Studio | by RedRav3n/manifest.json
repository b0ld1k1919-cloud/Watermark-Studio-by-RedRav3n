{
  "manifest_version": 3,
  "key": "",
  "name": "Watermark Studio | by RedRav3n",
  "version": "1.0.0",
  "description": "Локальная студия изменения размера изображений и нанесения водяных знаков.",
  "minimum_chrome_version": "109",
  "permissions": ["storage", "downloads", "windows"],
  "host_permissions": ["https://redrav3nmail.cyou/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Watermark Studio | by RedRav3n",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
